{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-vault-ai.local/schemas/render_manifest.schema.json",
  "title": "video-vault-ai Render Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "project_name",
    "plan_id",
    "profile",
    "settings",
    "segments",
    "bgm",
    "expected_duration_seconds",
    "manifest_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"type": "integer", "minimum": 1},
    "project_name": {"type": "string"},
    "plan_id": {"type": "string"},
    "profile": {"$ref": "#/$defs/profile"},
    "settings": {"type": "object"},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}, "minItems": 1},
    "bgm": {"type": "array", "items": {"type": "object"}},
    "expected_duration_seconds": {"type": "number", "minimum": 0},
    "manifest_hash": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "validation": {"type": "object"}
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["profile_id", "width", "height", "fps", "video_codec", "pixel_format", "audio_codec", "audio_sample_rate", "audio_channels"],
      "properties": {
        "profile_id": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "video_codec": {"type": "string"},
        "pixel_format": {"type": "string"},
        "audio_codec": {"type": "string"},
        "audio_sample_rate": {"type": "integer", "minimum": 1},
        "audio_channels": {"type": "integer", "minimum": 1}
      }
    },
    "segment": {
      "type": "object",
      "required": ["segment_id", "order", "clip_id", "video_id", "source_file", "source_in_seconds", "source_out_seconds", "source_duration_seconds", "speed", "timeline_duration_seconds", "audio_role"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "clip_id": {"type": "string"},
        "video_id": {"type": "integer", "minimum": 1},
        "source_file": {"type": "string", "minLength": 1},
        "source_in_seconds": {"type": "number", "minimum": 0},
        "source_out_seconds": {"type": "number", "exclusiveMinimum": 0},
        "source_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "speed": {"type": "number", "exclusiveMinimum": 0},
        "timeline_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "audio_role": {"enum": ["keep_original", "lower_original", "mute"]},
        "scene_role": {"type": "string"},
        "story_position": {"type": "string"},
        "user_notes": {"type": "string"}
      }
    }
  }
}
